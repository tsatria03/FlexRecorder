void mainmenu()
{
    select_default_device();
    while (true)
    {
        wait(5);
        form.reset();
        form.create_window("FlexRecorder", false);
        int startBtn = -1, stopBtn = -1, playBtn = -1, prefBtn = -1;
        if (is_recording)
        {
            stopBtn = form.create_button("S&top recording");
        }
        else if (has_recording)
        {
            playBtn = form.create_button("Sho&w recording");
            startBtn = form.create_button("&Start recording");
            prefBtn = form.create_button("Pre&ferences");
        }
        else
        {
            startBtn = form.create_button("&Start recording");
            prefBtn = form.create_button("Pre&ferences");
        }
        form.focus(is_recording ? stopBtn : (has_recording ? playBtn : startBtn));
        while (true)
        {
            wait(5);
            form.monitor();
            if (key_pressed(KEY_ESCAPE))
            {
                if (is_recording)
                    speak("Stop recording before exiting.");
                else
                {
                    rec.stop_playback();
                    exit();
                }
            }
            // Guard against the capture device dropping out mid-recording: if recording stops on its own, finalize and rebuild the menu.
            if (is_recording && !rec.recording)
            {
                has_recording = rec.stop_recording();
                is_recording = false;
                speak(has_recording ? "Recording stopped unexpectedly." : "Recording stopped unexpectedly with no audio saved.");
                break;
            }
            if (startBtn >= 0 && form.is_pressed(startBtn))
            {
                rec.stop_playback();
                rec.clear_recording();
                has_recording = false;
                if (rec.start_recording())
                {
                    is_recording = true;
                    break;
                }
                else
                    speak("Failed to start recording.");
            }
            if (stopBtn >= 0 && form.is_pressed(stopBtn))
            {
                if (rec.stop_recording())
                {
                    is_recording = false;
                    has_recording = true;
                    break;
                }
                else
                    speak("Failed to stop recording.");
            }
            if (playBtn >= 0 && form.is_pressed(playBtn))
            {
                show_recording();
                break;
            }
            if (prefBtn >= 0 && form.is_pressed(prefBtn))
            {
                prefsmenu();
                break;
            }
        }
    }
}

void show_recording()
{
    int saved_effect_pos = 0;
    int saved_tab = 0;
    float[] rev_s = {0.5, 1.5, 0.5, 0.5, 0.5};
    float[] echo_s = {1.0, 1.0, 0.5, 0.5};
    float[] low_s = {11000, 5.0, 0.5};
    float[] highpass_s = {11000, 5.0, 0.5};
    float[] chorus_s = {1.0, 1.0, 0.5, 3000, 3000, 500};
    float[] dist_s = {2.5, 2.5, 2.5, 0.5, 1.0};
    float[] phaser_s = {1.0, 1.0, 5, 0.5, 0.5, 180};
    float[] flanger_s = {1.0, 1.0, 0.5, 10, 10, 5};
    bool do_build = true;
    int last_effect_pos = -1;
    bool seen_playing = false;
    string last_fx = "force"; // sentinel so the first frame syncs playback to the list (clearing any leftover effect)
    int tab_player = 0, tab_controls = 1, tab_effects = 2;
    int tabs = -1, playBtn = -1, saveBtn = -1, clearBtn = -1, volSlider = -1, pitchSlider = -1, panSlider = -1, effect_list = -1;
    int s1 = -1, s2 = -1, s3 = -1, s4 = -1, s5 = -1, s6 = -1;
    while (true)
    {
        wait(5);
        if (do_build)
        {
            do_build = false;
            // Save the outgoing effect's slider values before the rebuild so they're restored when you switch back. (0 is "off", nothing to save.)
            if (last_effect_pos == 1)
            {
                echo_s[0] = form.get_slider(s1);
                echo_s[1] = form.get_slider(s2);
                echo_s[2] = form.get_slider(s3);
                echo_s[3] = form.get_slider(s4);
            }
            else if (last_effect_pos == 2)
            {
                rev_s[0] = form.get_slider(s1);
                rev_s[1] = form.get_slider(s2);
                rev_s[2] = form.get_slider(s3);
                rev_s[3] = form.get_slider(s4);
                rev_s[4] = form.get_slider(s5);
            }
            else if (last_effect_pos == 3)
            {
                low_s[0] = form.get_slider(s1);
                low_s[1] = form.get_slider(s2);
                low_s[2] = form.get_slider(s3);
            }
            else if (last_effect_pos == 4)
            {
                highpass_s[0] = form.get_slider(s1);
                highpass_s[1] = form.get_slider(s2);
                highpass_s[2] = form.get_slider(s3);
            }
            else if (last_effect_pos == 5)
            {
                chorus_s[0] = form.get_slider(s1);
                chorus_s[1] = form.get_slider(s2);
                chorus_s[2] = form.get_slider(s3);
                chorus_s[3] = form.get_slider(s4);
                chorus_s[4] = form.get_slider(s5);
                chorus_s[5] = form.get_slider(s6);
            }
            else if (last_effect_pos == 6)
            {
                dist_s[0] = form.get_slider(s1);
                dist_s[1] = form.get_slider(s2);
                dist_s[2] = form.get_slider(s3);
                dist_s[3] = form.get_slider(s4);
                dist_s[4] = form.get_slider(s5);
            }
            else if (last_effect_pos == 7)
            {
                phaser_s[0] = form.get_slider(s1);
                phaser_s[1] = form.get_slider(s2);
                phaser_s[2] = form.get_slider(s3);
                phaser_s[3] = form.get_slider(s4);
                phaser_s[4] = form.get_slider(s5);
                phaser_s[5] = form.get_slider(s6);
            }
            else if (last_effect_pos == 8)
            {
                flanger_s[0] = form.get_slider(s1);
                flanger_s[1] = form.get_slider(s2);
                flanger_s[2] = form.get_slider(s3);
                flanger_s[3] = form.get_slider(s4);
                flanger_s[4] = form.get_slider(s5);
                flanger_s[5] = form.get_slider(s6);
            }
            form.reset();
            form.create_window("Audio player", false, true, last_effect_pos != -1);
            tabs = form.create_tab_panel("Category");
            form.add_list_item(tabs, "Player");
            form.add_list_item(tabs, "Controls");
            form.add_list_item(tabs, "Effects");
            // Set the active tab before creating controls so each one's tab visibility is assigned correctly.
            form.set_list_position(tabs, (last_effect_pos == -1) ? tab_player : saved_tab);
            playBtn = form.create_button("&Play recording");
            form.assign_to_tab(playBtn, tabs, tab_player);
            saveBtn = form.create_button("Sa&ve recording");
            form.assign_to_tab(saveBtn, tabs, tab_player);
            clearBtn = form.create_button("&Clear recording");
            form.assign_to_tab(clearBtn, tabs, tab_player);
            volSlider = form.create_slider("Vol&ume", rec.playback.volume, -100, 0, "", 5);
            form.assign_to_tab(volSlider, tabs, tab_controls);
            pitchSlider = form.create_slider("Pi&tch", rec.playback.pitch, sound_pitch_lower_limit * 100, sound_pitch_upper_limit * 100, "", 5);
            form.assign_to_tab(pitchSlider, tabs, tab_controls);
            panSlider = form.create_slider("Pa&n", rec.playback.pan, -100, 100, "", 5);
            form.assign_to_tab(panSlider, tabs, tab_controls);
            effect_list = form.create_list("e&ffect type");
            form.add_list_item(effect_list, "none", "none");
            form.add_list_item(effect_list, "echo", "echo");
            form.add_list_item(effect_list, "reverb", "reverb");
            form.add_list_item(effect_list, "lowpass", "lowpass");
            form.add_list_item(effect_list, "highpass", "highpass");
            form.add_list_item(effect_list, "chorus", "chorus");
            form.add_list_item(effect_list, "distortion", "distortion");
            form.add_list_item(effect_list, "phaser", "phaser");
            form.add_list_item(effect_list, "flanger", "flanger");
            form.assign_to_tab(effect_list, tabs, tab_effects);
            form.set_list_position(effect_list, saved_effect_pos, false);
            s1 = -1;
            s2 = -1;
            s3 = -1;
            s4 = -1;
            s5 = -1;
            s6 = -1;
            if (saved_effect_pos == 1)
            {
                s1 = form.create_slider("&dry mix: ", echo_s[0], 0, 2, "", 0.01);
                s2 = form.create_slider("&wet mix: ", echo_s[1], 0, 2, "", 0.01);
                s3 = form.create_slider("&feedback: ", echo_s[2], 0, 1, "", 0.01);
                s4 = form.create_slider("&delay: ", echo_s[3], 0, 1.0, "s", 0.005);
            }
            else if (saved_effect_pos == 2)
            {
                s1 = form.create_slider("&dry mix: ", rev_s[0], 0, 1, "", 0.01);
                s2 = form.create_slider("&wet mix: ", rev_s[1], 0, 3, "", 0.01);
                s3 = form.create_slider("&room size: ", rev_s[2], 0, 1, "", 0.01);
                s4 = form.create_slider("dam&ping: ", rev_s[3], 0, 1, "", 0.01);
                s5 = form.create_slider("w&idth: ", rev_s[4], 0, 1, "", 0.01);
            }
            else if (saved_effect_pos == 3)
            {
                s1 = form.create_slider("&frequency: ", low_s[0], 0, 22000, "hz", 100);
                s2 = form.create_slider("&bandwidth: ", low_s[1], 0, 10, "oct", 0.1);
                s3 = form.create_slider("&quality: ", low_s[2], 0, 1, "", 0.01);
            }
            else if (saved_effect_pos == 4)
            {
                s1 = form.create_slider("&frequency: ", highpass_s[0], 0, 22000, "hz", 100);
                s2 = form.create_slider("&bandwidth: ", highpass_s[1], 0, 10, "oct", 0.1);
                s3 = form.create_slider("&quality: ", highpass_s[2], 0, 1, "", 0.01);
            }
            else if (saved_effect_pos == 5)
            {
                s1 = form.create_slider("&dry mix: ", chorus_s[0], 0, 2, "", 0.01);
                s2 = form.create_slider("&wet mix: ", chorus_s[1], 0, 2, "", 0.01);
                s3 = form.create_slider("&feedback: ", chorus_s[2], 0, 1, "", 0.01);
                s4 = form.create_slider("min s&weep: ", chorus_s[3], 0, 6000, "ms", 10);
                s5 = form.create_slider("max sw&eep: ", chorus_s[4], 0, 6000, "ms", 10);
                s6 = form.create_slider("&rate: ", chorus_s[5], 0, 1000, "ms/s", 5);
            }
            else if (saved_effect_pos == 6)
            {
                s1 = form.create_slider("d&rive: ", dist_s[0], 0, 5, "", 0.01);
                s2 = form.create_slider("&dry mix: ", dist_s[1], 0, 5, "", 0.01);
                s3 = form.create_slider("&wet mix: ", dist_s[2], 0, 5, "", 0.01);
                s4 = form.create_slider("&feedback: ", dist_s[3], 0, 1, "", 0.01);
                s5 = form.create_slider("&volume: ", dist_s[4], 0, 2, "", 0.01);
            }
            else if (saved_effect_pos == 7)
            {
                s1 = form.create_slider("&dry mix: ", phaser_s[0], 0, 2, "", 0.01);
                s2 = form.create_slider("&wet mix: ", phaser_s[1], 0, 2, "", 0.01);
                s3 = form.create_slider("&rate: ", phaser_s[2], 0, 10, "hz");
                s4 = form.create_slider("de&pth: ", phaser_s[3], 0, 1, "", 0.01);
                s5 = form.create_slider("&feedback: ", phaser_s[4], 0, 1, "", 0.01);
                s6 = form.create_slider("p&hase: ", phaser_s[5], 0, 360, "deg");
            }
            else if (saved_effect_pos == 8)
            {
                s1 = form.create_slider("&dry mix: ", flanger_s[0], 0, 2, "", 0.01);
                s2 = form.create_slider("&wet mix: ", flanger_s[1], 0, 2, "", 0.01);
                s3 = form.create_slider("&feedback: ", flanger_s[2], 0, 1, "", 0.01);
                s4 = form.create_slider("min &delay: ", flanger_s[3], 0, 20, "ms");
                s5 = form.create_slider("max d&elay: ", flanger_s[4], 0, 20, "ms");
                s6 = form.create_slider("&rate: ", flanger_s[5], 0, 10, "hz");
            }
            if (s1 != -1) form.assign_to_tab(s1, tabs, tab_effects);
            if (s2 != -1) form.assign_to_tab(s2, tabs, tab_effects);
            if (s3 != -1) form.assign_to_tab(s3, tabs, tab_effects);
            if (s4 != -1) form.assign_to_tab(s4, tabs, tab_effects);
            if (s5 != -1) form.assign_to_tab(s5, tabs, tab_effects);
            if (s6 != -1) form.assign_to_tab(s6, tabs, tab_effects);
            if (last_effect_pos == -1)
                form.focus(playBtn);
            else
                // Re-focus the list silently; the list's own arrow-navigation already announced the new effect.
                form.focus_silently(effect_list);
            last_effect_pos = saved_effect_pos;
            if (rec.playback.playing) form.set_caption(playBtn, "&Stop playback");
        }
        wait(5);
        form.monitor();
        // Apply the control sliders to the playback in real time.
        rec.playback.volume = form.get_slider(volSlider);
        rec.playback.pitch = form.get_slider(pitchSlider);
        rec.playback.pan = form.get_slider(panSlider);
        // Switching the effect type rebuilds the window (its sliders differ per effect); stay on the effects tab.
        int cur_effect_pos = form.get_list_position(effect_list);
        if (cur_effect_pos != -1 && cur_effect_pos != last_effect_pos)
        {
            saved_effect_pos = cur_effect_pos;
            saved_tab = form.get_list_position(tabs);
            do_build = true;
            continue;
        }
        // Apply the selected effect to the playback in real time. One effect active at a time; "off" (0) clears everything.
        string cur_tag = "";
        string cur_fx = "";
        if (saved_effect_pos == 1)
        {
            cur_tag = "$echo";
            cur_fx = "$echo:echo4:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":0";
        }
        else if (saved_effect_pos == 2)
        {
            cur_tag = "$reverb";
            cur_fx = "$reverb:freeverb:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":" + form.get_slider(s5);
        }
        else if (saved_effect_pos == 3)
        {
            cur_tag = "$lowpass";
            cur_fx = "$lowpass:lowpass:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3);
        }
        else if (saved_effect_pos == 4)
        {
            cur_tag = "$highpass";
            cur_fx = "$highpass:highpass:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3);
        }
        else if (saved_effect_pos == 5)
        {
            cur_tag = "$chorus";
            cur_fx = "$chorus:chorus:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":" + form.get_slider(s5) + ":" + form.get_slider(s6);
        }
        else if (saved_effect_pos == 6)
        {
            cur_tag = "$distortion";
            cur_fx = "$distortion:distortion:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":" + form.get_slider(s5);
        }
        else if (saved_effect_pos == 7)
        {
            cur_tag = "$phaser";
            cur_fx = "$phaser:phaser:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":" + form.get_slider(s5) + ":" + form.get_slider(s6);
        }
        else if (saved_effect_pos == 8)
        {
            cur_tag = "$flanger";
            cur_fx = "$flanger:flanger:" + form.get_slider(s1) + ":" + form.get_slider(s2) + ":" + form.get_slider(s3) + ":" + form.get_slider(s4) + ":" + form.get_slider(s5) + ":" + form.get_slider(s6);
        }
        if (cur_fx != last_fx)
        {
            clear_effects();
            if (cur_tag != "") add_effect(cur_fx, cur_tag);
            apply_effects();
            last_fx = cur_fx;
        }
        // Revert the button label when playback finishes on its own (only after we've actually seen it playing, to avoid a startup race).
        if (rec.playback.playing)
            seen_playing = true;
        else if (seen_playing && form.get_caption(playBtn) == "Stop playback")
        {
            seen_playing = false;
            form.set_caption(playBtn, "&Play recording");
        }
        if (key_pressed(KEY_ESCAPE))
        {
            rec.stop_playback();
            return;
        }
        // The play/stop button, or Enter while focused on any slider (controls or effects), toggles playback.
        bool toggle_play = form.is_pressed(playBtn);
        if (!toggle_play && key_pressed(KEY_RETURN))
        {
            int focus = form.get_current_focus();
            if (focus >= 0 && (focus == volSlider || focus == pitchSlider || focus == panSlider || focus == s1 || focus == s2 || focus == s3 || focus == s4 || focus == s5 || focus == s6))
                toggle_play = true;
        }
        if (toggle_play)
        {
            if (rec.playback.playing)
            {
                rec.stop_playback();
                form.set_caption(playBtn, "&Play recording");
                speak("Stopped recorded audio.");
            }
            else
            {
                rec.play();
                form.set_caption(playBtn, "&Stop playback");
                speak("Playing recorded audio.");
            }
        }
        if (form.is_pressed(saveBtn))
        {
            rec.stop_playback();
            save_current_recording();
            return;
        }
        if (form.is_pressed(clearBtn))
        {
            rec.stop_playback();
            rec.clear_recording();
            has_recording = false;
            return;
        }
    }
}

void prefsmenu()
{
    string[]@ all_devices = rec.list_recording_devices(true);
    form.reset();
    form.create_window("Preferences", false);
    string[]@ out_devices = get_sound_output_devices();
    int playbackList = form.create_list("Playback device", 0);
    int selected_playback = 0;
    // The default device sits first, then every other device sorted alphabetically. Index 0 is the reserved slot, so it's skipped.
    for (uint i = 1; i < out_devices.length(); i++)
    {
        if (out_devices[i].lower().find_first("default") < 0) continue;
        form.add_list_item(playbackList, out_devices[i], ""+i);
        if (out_devices[i] == playdev) selected_playback = form.get_list_count(playbackList) - 1;
    }
    string[] out_names;
    int[] out_indices;
    for (uint i = 1; i < out_devices.length(); i++)
    {
        if (out_devices[i].lower().find_first("default") >= 0) continue;
        out_names.insert_last(out_devices[i]);
        out_indices.insert_last(int(i));
    }
    // Insertion sort the remaining devices by name, case-insensitive, keeping each device's original index.
    for (uint a = 1; a < out_names.length(); a++)
    {
        string nk = out_names[a];
        int ik = out_indices[a];
        int b = int(a) - 1;
        while (b >= 0 && out_names[b].lower() > nk.lower())
        {
            out_names[b + 1] = out_names[b];
            out_indices[b + 1] = out_indices[b];
            b--;
        }
        out_names[b + 1] = nk;
        out_indices[b + 1] = ik;
    }
    for (uint a = 0; a < out_names.length(); a++)
    {
        form.add_list_item(playbackList, out_names[a], ""+out_indices[a]);
        if (out_names[a] == playdev) selected_playback = form.get_list_count(playbackList) - 1;
    }
    if (form.get_list_count(playbackList) > 0) form.set_list_position(playbackList, selected_playback);
    int deviceList = form.create_list("Recording device", 0);
    int selected_device = 0;
    // The default device sits first, then every other device sorted alphabetically.
    for (uint i = 0; i < all_devices.length(); i++)
    {
        if (all_devices[i].lower().find_first("default") < 0) continue;
        string dev_name = all_devices[i];
        int colon_pos = dev_name.find_first(": ");
        if (colon_pos >= 0) dev_name = dev_name.substr(colon_pos + 2);
        form.add_list_item(deviceList, dev_name, ""+i);
        if (dev_name == recdev) selected_device = form.get_list_count(deviceList) - 1;
    }
    string[] dev_names;
    int[] dev_indices;
    for (uint i = 0; i < all_devices.length(); i++)
    {
        if (all_devices[i].lower().find_first("default") >= 0) continue;
        string dev_name = all_devices[i];
        int colon_pos = dev_name.find_first(": ");
        if (colon_pos >= 0) dev_name = dev_name.substr(colon_pos + 2);
        dev_names.insert_last(dev_name);
        dev_indices.insert_last(int(i));
    }
    // Insertion sort the remaining devices by name, case-insensitive, keeping each device's original index.
    for (uint a = 1; a < dev_names.length(); a++)
    {
        string nk = dev_names[a];
        int ik = dev_indices[a];
        int b = int(a) - 1;
        while (b >= 0 && dev_names[b].lower() > nk.lower())
        {
            dev_names[b + 1] = dev_names[b];
            dev_indices[b + 1] = dev_indices[b];
            b--;
        }
        dev_names[b + 1] = nk;
        dev_indices[b + 1] = ik;
    }
    for (uint a = 0; a < dev_names.length(); a++)
    {
        form.add_list_item(deviceList, dev_names[a], ""+dev_indices[a]);
        if (dev_names[a] == recdev) selected_device = form.get_list_count(deviceList) - 1;
    }
    if (form.get_list_count(deviceList) > 0) form.set_list_position(deviceList, selected_device);
    int okBtn = form.create_button("&Okay", true);
    int cancelBtn = form.create_button("&Cancel");
    form.focus(playbackList);
    while (true)
    {
        wait(5);
        form.monitor();
        if (key_pressed(KEY_ESCAPE)) return;
        if (form.is_pressed(cancelBtn)) return;
        if (form.is_pressed(okBtn))
        {
            int playPos = form.get_list_position(playbackList);
            if (playPos >= 0)
            {
                sound_output_device = string_to_int(form.get_list_item_id(playbackList, playPos));
                playdev = form.get_list_item(playbackList, playPos);
            }
            int devPos = form.get_list_position(deviceList);
            if (devPos >= 0)
            {
                rec.set_recording_device(string_to_int(form.get_list_item_id(deviceList, devPos)));
                recdev = form.get_list_item(deviceList, devPos);
            }
            writepreffs();
            return;
        }
    }
}

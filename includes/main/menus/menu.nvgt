void mainmenu()
{
    if (!directory_exists(recordingsPath)) directory_create(recordingsPath);
    select_default_device();
    while (true)
    {
        wait(5);
        form.reset();
        form.create_window("FlexRecorder", false);
        int startBtn = -1, stopBtn = -1, playBtn = -1, clearBtn = -1, saveBtn = -1, prefBtn = -1;
        if (is_recording)
        {
            stopBtn = form.create_button("S&top recording");
        }
        else if (has_recording)
        {
            playBtn = form.create_button("&Play recording");
            saveBtn = form.create_button("Sa&ve recording");
            clearBtn = form.create_button("&Clear recording");
            startBtn = form.create_button("&Start recording");
            prefBtn = form.create_button("Pre&ferences");
        }
        else
        {
            startBtn = form.create_button("&Start recording");
            prefBtn = form.create_button("Pre&ferences");
        }
        form.focus(is_recording ? stopBtn : (has_recording ? playBtn : startBtn));
        while (true)
        {
            wait(5);
            form.monitor();
            if (key_pressed(KEY_ESCAPE))
            {
                if (is_recording)
                    speak("Stop recording before exiting.");
                else
                {
                    rec.stop_playback();
                    exit();
                }
            }
            if (startBtn >= 0 && form.is_pressed(startBtn))
            {
                rec.stop_playback();
                rec.clear_recording();
                has_recording = false;
                if (rec.start_recording())
                {
                    is_recording = true;
                    break;
                }
                else
                    speak("Failed to start recording.");
            }
            if (stopBtn >= 0 && form.is_pressed(stopBtn))
            {
                if (rec.stop_recording())
                {
                    is_recording = false;
                    has_recording = true;
                    break;
                }
                else
                    speak("Failed to stop recording.");
            }
            if (playBtn >= 0 && form.is_pressed(playBtn))
            {
                if (rec.playback.playing)
                {
                    rec.stop_playback();
                    speak("Stopped recorded audio.");
                }
                else
                {
                    rec.play();
                    speak("Playing recorded audio.");
                }
            }
            if (clearBtn >= 0 && form.is_pressed(clearBtn))
            {
                rec.stop_playback();
                rec.clear_recording();
                has_recording = false;
                break;
            }
            if (saveBtn >= 0 && form.is_pressed(saveBtn))
            {
                save_current_recording();
                break;
            }
            if (prefBtn >= 0 && form.is_pressed(prefBtn))
            {
                preferences();
                break;
            }
        }
    }
}

void preferences()
{
    string[]@ all_devices = rec.list_recording_devices(true);
    form.reset();
    form.create_window("Preferences", false);
    int nameBox = form.create_input_box("Default recording filename", default_filename);
    int deviceList = form.create_list("Recording device", 0);
    int selected_device = 0;
    // The default device sits first, then every other device sorted alphabetically.
    for (uint i = 0; i < all_devices.length(); i++)
    {
        if (all_devices[i].lower().find_first("default") < 0) continue;
        string dev_name = all_devices[i];
        int colon_pos = dev_name.find_first(": ");
        if (colon_pos >= 0) dev_name = dev_name.substr(colon_pos + 2);
        form.add_list_item(deviceList, dev_name, ""+i);
        if (i == rec.recording_device) selected_device = form.get_list_count(deviceList) - 1;
    }
    string[] dev_names;
    int[] dev_indices;
    for (uint i = 0; i < all_devices.length(); i++)
    {
        if (all_devices[i].lower().find_first("default") >= 0) continue;
        string dev_name = all_devices[i];
        int colon_pos = dev_name.find_first(": ");
        if (colon_pos >= 0) dev_name = dev_name.substr(colon_pos + 2);
        dev_names.insert_last(dev_name);
        dev_indices.insert_last(int(i));
    }
    // Insertion sort the remaining devices by name, case-insensitive, keeping each device's original index.
    for (uint a = 1; a < dev_names.length(); a++)
    {
        string nk = dev_names[a];
        int ik = dev_indices[a];
        int b = int(a) - 1;
        while (b >= 0 && dev_names[b].lower() > nk.lower())
        {
            dev_names[b + 1] = dev_names[b];
            dev_indices[b + 1] = dev_indices[b];
            b--;
        }
        dev_names[b + 1] = nk;
        dev_indices[b + 1] = ik;
    }
    for (uint a = 0; a < dev_names.length(); a++)
    {
        form.add_list_item(deviceList, dev_names[a], ""+dev_indices[a]);
        if (dev_indices[a] == int(rec.recording_device)) selected_device = form.get_list_count(deviceList) - 1;
    }
    if (form.get_list_count(deviceList) > 0) form.set_list_position(deviceList, selected_device);
    int okBtn = form.create_button("&Okay", true);
    int cancelBtn = form.create_button("&Cancel");
    form.focus(nameBox);
    while (true)
    {
        wait(5);
        form.monitor();
        if (key_pressed(KEY_ESCAPE)) return;
        if (form.is_pressed(cancelBtn)) return;
        if (form.is_pressed(okBtn))
        {
            int devPos = form.get_list_position(deviceList);
            if (devPos >= 0) rec.set_recording_device(string_to_int(form.get_list_item_id(deviceList, devPos)));
            string nm = form.get_text(nameBox).trim_whitespace_left().trim_whitespace_right();
            if (nm != "") default_filename = nm;
            return;
        }
    }
}

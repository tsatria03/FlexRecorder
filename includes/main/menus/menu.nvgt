bool do_build = true;
int last_effect_pos = -1;
int effect_list;
int s1, s2, s3, s4, s5, s6;
int efok, efcn;
while (true)
{
wait(5);
if (do_build)
{
do_build = false;
if (last_effect_pos != -1)
{

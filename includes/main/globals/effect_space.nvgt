double[] effect_params;

class effect_zone
{
string zone_id;
string fx_string;
string clear_tag;
effect_zone() {}
effect_zone(string id, string fx, string ctag)
{
zone_id = id;
fx_string = fx;
clear_tag = ctag;
}
}

effect_zone@[] effect_spaces(0);

void apply_all_effects(sound_pool@ pool)
{
string[] tags = {"$reverb", "$echo", "$lowpass", "$highpass", "$chorus", "$distortion", "$phaser", "$flanger"};
for (uint t = 0; t < tags.length(); t++)
{
bool found = false;
for (uint i = 0; i < effect_spaces.length(); i++)
{
if (effect_spaces[i].clear_tag != tags[t]) continue;
pool.mixer.set_fx(effect_spaces[i].fx_string);
found = true;
break;
}
if (!found) pool.mixer.set_fx(tags[t]);
}
}

void apply_effect_pools()
{
apply_all_effects(pool);
}
void spawn_effect_space(string fx, string ctag)
{
string id = generate_custom_token(random(5, 10), "1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ");
effect_spaces.insert_last(effect_zone(id, fx, ctag));
}

void destroy_all_effect_spaces()
{
effect_spaces.resize(0);
}

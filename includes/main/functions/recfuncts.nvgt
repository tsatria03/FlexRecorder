void select_default_device()
{
    if (rec.recording_device != uint(-1)) return;
    string[]@ devs = rec.list_recording_devices(true);
    for (uint i = 0; i < devs.length(); i++)
    {
        if (devs[i].lower().find_first("default") >= 0)
        {
            rec.set_recording_device(i);
            return;
        }
    }
    if (devs.length() > 0) rec.set_recording_device(0);
}

void discard_recording()
{
    rec.stop_playback();
    clear_effects();
    apply_effects();
    rec.playback.volume = 0;
    rec.playback.pitch = 100;
    rec.playback.pan = 0;
    rec.clear_recording();
    has_recording = false;
}

void save_current_recording()
{
    string stamp = get_date(false, true) + " " + get_time(false, false);
    stamp = stamp.replace(":", "-", true).replace("/", "-", true);
    string filename = sanitize_filename(stamp);
    string wav_path = recordingsPath + filename + ".wav";
    string mp3_path = recordingsPath + filename + ".mp3";
    if (rec.playback.save(wav_path))
    {
        speak("Saving recording, please wait.");
        run("lib/lame.exe", "-b " + mp3quality + " \"" + wav_path + "\" \"" + mp3_path + "\"", true, true);
        if (file_exists(mp3_path)) file_delete(wav_path);
        if (file_exists(mp3_path))
            dlgmessage("Recording saved as " + filename + ".mp3. Press enter to continue.");
        else
            dlgmessage("Conversion failed. WAV file kept at " + wav_path + ". Press enter to continue.");
    }
    else
        dlgmessage("Failed to save recording. Press enter to continue.");
}
